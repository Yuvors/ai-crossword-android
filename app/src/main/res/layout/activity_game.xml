<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_close"
        app:subtitle="15×15 · בינוני"
        app:title="תשחץ #128" />

    <!-- Timer and progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding">

        <TextView
            android:id="@+id/text_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 12:40"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:progress="62"
            app:indicatorColor="@color/amber"
            app:trackColor="@color/outline"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="62%"
            android:textAppearance="@style/TextAppearance.Tashchetz.Caption" />
    </LinearLayout>

    <!-- Clue bar: the selected word's clue, large and readable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/gap"
        android:background="@drawable/bg_clue_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/ink_light"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מאוזן · 5 אותיות"
                android:textColor="@color/amber"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_clue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="עיר הבירה של צרפת"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="@color/ink_light"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Placeholder for ArrowGridView, the custom view we will build. Made square in GameActivity. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:id="@+id/grid_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_placeholder"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כאן יוצג גריד התשחץ"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="ArrowGridView: משבצות אותיות, משבצות הגדרה עם חיצים, זום וגרירה"
                android:textAppearance="@style/TextAppearance.Tashchetz.Caption" />
        </LinearLayout>
    </FrameLayout>

    <!-- Hebrew keyboard, filled by GameActivity. Laid out left to right like a physical keyboard. -->
    <LinearLayout
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ink_light"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp" />
</LinearLayout>
